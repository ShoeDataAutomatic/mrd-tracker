# OOS local cron config — copy this file to oos_config.env and fill in values.
# oos_config.env is gitignored (never committed).

# Railway app URL
RAILWAY_URL=https://web-production-c511e.up.railway.app

# Secret key — must match OOS_API_KEY env var set in Railway dashboard
OOS_API_KEY=replace-with-your-secret-key
